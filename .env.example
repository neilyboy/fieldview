# Port the app listens on inside compose (mapped to host PORT)
PORT=3200

# Postgres
POSTGRES_USER=fieldview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fieldview
DATABASE_URL=postgresql://fieldview:change-me@db:5432/fieldview

# Initial admin credentials (password can be changed in Admin after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Random 32+ char secret for session signing
SESSION_SECRET=replace-with-long-random-string

# Public base URL (used in share links / PDFs), e.g. https://vercams.neilyboy.net
APP_BASE_URL=http://localhost:3200

# Chromium path for PDF export (inside container)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

UPLOAD_DIR=/data/uploads

# Only needed for local dev outside docker (internal port is fixed at 3000 in compose)
# INTERNAL_BASE_URL=http://localhost:3004
